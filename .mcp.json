{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer YOUR_GITHUB_TOKEN" }
    },
    "linear": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mkusaka/mcp-server-linear@latest"],
      "env": { "LINEAR_API_KEY": "YOUR_LINEAR_API_KEY" }
    }
  }
}
